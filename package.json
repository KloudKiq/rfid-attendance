{
  "name": "rfid-attendance",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron-builder install-app-deps && electron .",
    "dist": "electron-builder --win",
    "rebuild:node": "npm rebuild better-sqlite3 node-hid serialport",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "express": "^4.18.3",
    "express-session": "^1.18.1",
    "node-hid": "^3.3.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.kloudkiq.rfid-attendance",
    "productName": "RFID Attendance",
    "files": [
      "app.js",
      "rfid-reader.js",
      "serial-reader.js",
      "public/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.db",
      "!**/*.db-journal"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
